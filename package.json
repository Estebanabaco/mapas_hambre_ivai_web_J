{
  "name": "ivai2024",
  "private": true,
  "version": "0.1.0",
  "description": "Visor IVAI con arquitectura modular",
  "type": "module",
  "scripts": {
    "check:js": "node scripts/check-syntax.mjs",
    "check:php": "php -l \"src/adapters/wordpress/ivai-wordpress.php\"",
    "test:wp-adapter": "php \"scripts/test-wordpress-adapter.php\"",
    "check": "npm run check:js && npm run check:php && npm run test:wp-adapter",
    "build:dist": "node scripts/build-dist.mjs",
    "build": "npm run check && npm run build:dist"
  }
}
